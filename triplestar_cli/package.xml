<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>triplestar_cli</name>
  <version>0.0.0</version>
  <description>CLI extension for interacting with triplestar knowledge base services.</description>
  <maintainer email="derijkmarijn00@gmail.com">marijn</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>ros2cli</depend>
  <depend>triplestar_msgs</depend>
  <depend>triplestar_bringup</depend>
  <depend>triplestar_core</depend>
  <depend>ament_index_python</depend>
  <depend>python3-cookiecutter</depend>
  <depend>python3-tabulate</depend>
  <depend>python3-rich</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
